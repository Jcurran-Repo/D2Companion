<Window x:Class="D2Companion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:D2Companion.App"
        Title="D2Companion — Diablo II voice companion"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        FontFamily="Palatino Linotype"
        Background="{StaticResource D2.WindowBgBrush}"
        Foreground="{StaticResource D2.TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:GearQualityBrushConverter x:Key="GearQualityBrush"/>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,3,6,3"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource D2.TextDimBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,6,0">
            <Button Content="New character" Command="{Binding NewCharacterCommand}"/>
            <Button Content="Export…" Command="{Binding ExportCommand}"/>
            <Button Content="Import…" Command="{Binding ImportCommand}"/>
            <Button Content="Settings…" Command="{Binding OpenSettingsCommand}"/>
        </StackPanel>

        <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 0: character sheet -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <GroupBox Header="Character sheet">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Class"/>
                    <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mode"/>
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patch / season"/>
                    <TextBox Text="{Binding PatchOrSeason, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Build goal"/>
                    <TextBox Text="{Binding BuildGoal, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Difficulty"/>
                    <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Act"/>
                    <TextBox Text="{Binding Act, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Level"/>
                    <TextBox Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Attributes (STR / DEX / VIT / ENE)"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,2,3,2" Text="{Binding Strength, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="1" Margin="0,2,3,2" Text="{Binding Dexterity, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Margin="0,2,3,2" Text="{Binding Vitality, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="3" Margin="0,2,0,2" Text="{Binding Energy, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Button Content="Apply corrections" Command="{Binding ApplySheetCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock Text="Edits here are logged as Manual in the ledger."
                               Foreground="{StaticResource D2.TextFaintBrush}" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </ScrollViewer>

        <!-- Column 1: skills / gear / reminders -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Skills">
                    <StackPanel>
                        <ListView Height="130" ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Skill" Width="150" DisplayMemberBinding="{Binding Skill}"/>
                                    <GridViewColumn Header="Tree" Width="110" DisplayMemberBinding="{Binding Tree}"/>
                                    <GridViewColumn Header="Pts" Width="45" DisplayMemberBinding="{Binding Points}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,2,3,2" Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Skill name"/>
                            <TextBox Grid.Column="1" Margin="0,2,3,2" Text="{Binding NewSkillTree, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tree"/>
                            <TextBox Grid.Column="2" Width="45" Margin="0,2" Text="{Binding NewSkillPoints, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Points"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Set / add" Command="{Binding AddOrUpdateSkillCommand}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveSelectedSkillCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Gear">
                    <StackPanel>
                        <ListView Height="120" ItemsSource="{Binding Gear}" SelectedItem="{Binding SelectedGear}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Slot" Width="90" DisplayMemberBinding="{Binding Slot}"/>
                                    <GridViewColumn Header="Item" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Item names take their in-game quality color -->
                                                <TextBlock Text="{Binding Item}"
                                                           Foreground="{Binding Converter={StaticResource GearQualityBrush}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Notes" Width="150" DisplayMemberBinding="{Binding Notes}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBox Text="{Binding NewGearSlot, UpdateSourceTrigger=PropertyChanged}" ToolTip="Slot (e.g. Weapon)"/>
                        <TextBox Text="{Binding NewGearItem, UpdateSourceTrigger=PropertyChanged}" ToolTip="Item / runeword"/>
                        <TextBox Text="{Binding NewGearNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Notes (optional)"/>
                        <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding NewGearQuality}"
                                  ToolTip="Item quality (colors the name; Unknown = detect from text)"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Set / add" Command="{Binding AddOrUpdateGearCommand}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveSelectedGearCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Reminders">
                    <StackPanel>
                        <ListBox Height="90" ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}"/>
                        <TextBox Text="{Binding NewReminder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reminder text"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add" Command="{Binding AddReminderCommand}"/>
                            <Button Content="Remove selected" Command="{Binding RemoveSelectedReminderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Farming runs">
                    <StackPanel>
                        <ListView Height="90" ItemsSource="{Binding RunSummaries}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Target" Width="110" DisplayMemberBinding="{Binding Target}"/>
                                    <GridViewColumn Header="Runs" Width="45" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="Last find" Width="150" DisplayMemberBinding="{Binding LastDrop}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="Tell Claude when a run is done — it keeps the tally."
                                   Foreground="{StaticResource D2.TextFaintBrush}" FontStyle="Italic"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Deaths">
                    <ListBox Height="70" ItemsSource="{Binding Deaths}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource D2.TextFaintBrush}"/><Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource D2.RedBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Column 2: decision ledger + Phase 1 placeholder -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Decision ledger (newest first)">
                <ListBox ItemsSource="{Binding Ledger}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource D2.TextFaintBrush}"/>
                                    <!-- Claude's calls in unique gold, your edits in magic blue -->
                                    <TextBlock x:Name="SourceText" Text="{Binding Source}" Margin="8,0,0,0"
                                               FontWeight="SemiBold" Foreground="{StaticResource D2.GoldBrush}"/>
                                    <TextBlock Text="{Binding Details}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Rationale}" Foreground="{StaticResource D2.TextFaintBrush}"
                                           FontStyle="Italic" Margin="18,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Source}" Value="Manual">
                                    <Setter TargetName="SourceText" Property="Foreground" Value="{StaticResource D2.MagicBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Border Grid.Row="1" Margin="6" Padding="10" Background="{StaticResource D2.PanelBgBrush}"
                    BorderBrush="{StaticResource D2.BorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <Button x:Name="TalkButton" Content="🎤  Hold to talk"
                            HorizontalAlignment="Left" Padding="14,6" FontSize="14"
                            IsEnabled="{Binding VoiceEnabled}"
                            Visibility="{Binding IsPushToTalk, Converter={StaticResource BoolToVis}}"
                            PreviewMouseLeftButtonDown="TalkButton_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="TalkButton_PreviewMouseLeftButtonUp"/>
                    <Button Content="{Binding ListenButtonText}"
                            HorizontalAlignment="Left" Padding="14,6" FontSize="14"
                            IsEnabled="{Binding VoiceEnabled}"
                            Visibility="{Binding IsOpenMic, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ToggleListeningCommand}"/>
                    <TextBlock Text="{Binding VoiceStatus}" Margin="0,8,0,0"
                               Foreground="{StaticResource D2.GoldBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <!-- Speaker labels mirror the ledger: you = magic blue, Claude = unique gold -->
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="You:" FontWeight="SemiBold" Foreground="{StaticResource D2.MagicBrush}"/><Run Text=" "/><Run Text="{Binding LastHeard}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                        <Run Text="Claude:" FontWeight="SemiBold" Foreground="{StaticResource D2.GoldBrush}"/><Run Text=" "/><Run Text="{Binding LastReply}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>

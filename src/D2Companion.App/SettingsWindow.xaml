<Window x:Class="D2Companion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:D2Companion.App"
        Title="Settings" Height="720" Width="720"
        WindowStartupLocation="CenterOwner" FontSize="13"
        FontFamily="Palatino Linotype"
        Background="{StaticResource D2.WindowBgBrush}"
        Foreground="{StaticResource D2.TextBrush}">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InvertBool"/>
        <!-- Green while the detector hears speech, dim otherwise -->
        <Style x:Key="TunerStateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource D2.TextDimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TunerState}" Value="SPEECH">
                    <Setter Property="Foreground" Value="{StaticResource D2.SetBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0" Padding="6,3" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Padding="6,3" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Voice" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource D2.GoldBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Silence threshold" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding SilenceThreshold}"
                             ToolTip="Open-mic: mic energy below this counts as silence (try 400–1200)."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="End-of-turn silence (ms)" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding EndpointSilenceMs}"
                             ToolTip="How long a pause ends your turn (higher = more patient)."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Min speech (ms)" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding MinSpeechMs}"
                             ToolTip="Ignore utterances shorter than this (filters clicks/noise)."/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="TTS model" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding TtsModel}"
                             ToolTip="ElevenLabs text-to-speech model id."/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Reasoning effort" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}"
                              ToolTip="Higher = smarter but slower/pricier replies."/>
                </Grid>

                <TextBlock Text="Open-mic tuning" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource D2.GoldBrush}" Margin="0,14,0,4"/>
                <TextBlock Foreground="{StaticResource D2.TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Play game audio through your speakers at your real volume, then: start the meter, measure the noise for 10s without talking, then talk over it for 10s. Nothing here calls any API — it only measures. Threshold edits above apply to the meter instantly; real listening picks them up after Save + restart."/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding MeterButtonText}" Command="{Binding ToggleMeterCommand}" Margin="0,0,6,0"/>
                    <Button Content="Measure game noise (10 s)" Command="{Binding MeasureNoiseCommand}"
                            IsEnabled="{Binding IsMeasuring, Converter={StaticResource InvertBool}}" Margin="0,0,6,0"/>
                    <Button Content="Measure my voice (10 s)" Command="{Binding MeasureVoiceCommand}"
                            IsEnabled="{Binding IsMeasuring, Converter={StaticResource InvertBool}}" Margin="0,0,6,0"/>
                    <Button Content="Use suggestion" Command="{Binding ApplySuggestionCommand}"/>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="12" Maximum="4000" Value="{Binding CurrentEnergy, Mode=OneWay}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="now"/> <Run Text="{Binding CurrentEnergy, Mode=OneWay, StringFormat={}{0:F0}}"/>
                            <Run Text=" · peak" Foreground="{StaticResource D2.TextDimBrush}"/> <Run Text="{Binding PeakEnergy, Mode=OneWay, StringFormat={}{0:F0}}"/>
                            <Run Text=" · "/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TunerStateStyle}" Text="{Binding TunerState}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding NoiseResult}" Foreground="{StaticResource D2.TextDimBrush}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding VoiceResult}" Foreground="{StaticResource D2.TextDimBrush}"/>
                <TextBlock Text="{Binding SuggestionText}" Foreground="{StaticResource D2.GoldBrush}" TextWrapping="Wrap"/>

                <ListBox Height="110" Margin="0,6,0,0" ItemsSource="{Binding TuningLog}"/>

                <TextBlock Text="Reference sites" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource D2.GoldBrush}" Margin="0,14,0,4"/>
                <TextBlock Text="Sites Claude may consult to verify a decision. Add or remove rows."
                           Foreground="{StaticResource D2.TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding Sites}" AutoGenerateColumns="False"
                          CanUserAddRows="True" CanUserDeleteRows="True" Height="170" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max reference chars per lookup" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="0,4" Text="{Binding MaxReferenceChars}"/>
                </Grid>

                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource D2.TextFaintBrush}"
                           Text="Voice mode applies immediately. Thresholds, TTS model, effort, and site changes take effect after restarting the app."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

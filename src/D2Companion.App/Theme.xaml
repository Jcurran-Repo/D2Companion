<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Diablo II theme.
         Item-quality colors are the game's canonical text colors:
         unique gold #C7B377, magic blue #6969FF, rare yellow #FFFF64,
         set green #00FF00, crafted orange #FFA800.
         ============================================================ -->

    <!-- Palette -->
    <SolidColorBrush x:Key="D2.WindowBgBrush"   Color="#0B0906"/>
    <SolidColorBrush x:Key="D2.PanelBgBrush"    Color="#17110A"/>
    <SolidColorBrush x:Key="D2.ListBgBrush"     Color="#140F09"/>
    <SolidColorBrush x:Key="D2.InputBgBrush"    Color="#1F170D"/>
    <SolidColorBrush x:Key="D2.HeaderBgBrush"   Color="#20180E"/>
    <SolidColorBrush x:Key="D2.BorderBrush"     Color="#4A3B22"/>
    <SolidColorBrush x:Key="D2.BorderDimBrush"  Color="#33291A"/>
    <SolidColorBrush x:Key="D2.BorderHoverBrush" Color="#8A7443"/>
    <SolidColorBrush x:Key="D2.GoldBrush"       Color="#C7B377"/>
    <SolidColorBrush x:Key="D2.GoldBrightBrush" Color="#EBDCA9"/>
    <SolidColorBrush x:Key="D2.TextBrush"       Color="#D6C9A0"/>
    <SolidColorBrush x:Key="D2.TextDimBrush"    Color="#97865F"/>
    <SolidColorBrush x:Key="D2.TextFaintBrush"  Color="#6E6046"/>
    <SolidColorBrush x:Key="D2.MagicBrush"      Color="#6969FF"/>
    <SolidColorBrush x:Key="D2.RareBrush"       Color="#FFFF64"/>
    <SolidColorBrush x:Key="D2.SetBrush"        Color="#00FF00"/>
    <SolidColorBrush x:Key="D2.CraftedBrush"    Color="#FFA800"/>
    <SolidColorBrush x:Key="D2.RedBrush"        Color="#E04A4A"/>
    <SolidColorBrush x:Key="D2.HoverBgBrush"    Color="#241B10"/>
    <SolidColorBrush x:Key="D2.SelectedBgBrush" Color="#3A2B15"/>

    <LinearGradientBrush x:Key="D2.ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B2113" Offset="0"/>
        <GradientStop Color="#1A130A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="D2.ButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#342816" Offset="0"/>
        <GradientStop Color="#20180C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="D2.ButtonPressedBgBrush" Color="#120D07"/>

    <!-- Buttons: dark stone with a dull-gold rim that lights up on hover -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource D2.GoldBrush}"/>
        <Setter Property="Background" Value="{StaticResource D2.ButtonBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderBrush}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="2" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.ButtonHoverBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource D2.GoldBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource D2.GoldBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.ButtonPressedBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource D2.TextFaintBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource D2.BorderDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource D2.InputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="CaretBrush" Value="{StaticResource D2.GoldBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource D2.SelectedBgBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource D2.BorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource D2.GoldBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource D2.TextFaintBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox (non-editable) -->
    <ControlTemplate x:Key="D2.ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource D2.InputBgBrush}"
                BorderBrush="{StaticResource D2.BorderBrush}" BorderThickness="1" CornerRadius="2">
            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource D2.GoldBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource D2.BorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource D2.GoldBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.HoverBgBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.SelectedBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource D2.GoldBrightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource D2.ComboToggle}" Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="7,3,24,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource D2.ListBgBrush}"
                                    BorderBrush="{StaticResource D2.BorderBrush}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox: gold serif header over a dark leather panel -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource D2.HeaderBgBrush}"
                                BorderBrush="{StaticResource D2.BorderBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Padding="8,4">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{StaticResource D2.GoldBrush}"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.FontSize="14"/>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource D2.PanelBgBrush}"
                                BorderBrush="{StaticResource D2.BorderBrush}" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,3,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource D2.ListBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderDimBrush}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.HoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.SelectedBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource D2.ListBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderDimBrush}"/>
    </Style>

    <!-- ListViewItem for GridView columns -->
    <Style TargetType="ListViewItem">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.HoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.SelectedBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource D2.GoldBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{StaticResource D2.HeaderBgBrush}"
                                BorderBrush="{StaticResource D2.BorderDimBrush}" BorderThickness="0,0,1,1"
                                Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                               Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid (settings: reference-site editor) -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource D2.ListBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderDimBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#1A140C"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#241C11"/>
        <Setter Property="VerticalGridLinesBrush" Value="#241C11"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource D2.HeaderBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource D2.GoldBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderDimBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="4,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource D2.SelectedBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource D2.GoldBrightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource D2.HoverBgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollBars: slim, no arrows -->
    <Style x:Key="D2.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="D2.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource D2.BorderDimBrush}" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource D2.BorderHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="D2.VScrollBar" TargetType="ScrollBar">
        <Border Background="#0E0B07">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource D2.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource D2.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource D2.ScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="D2.HScrollBar" TargetType="ScrollBar">
        <Border Background="#0E0B07">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource D2.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource D2.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource D2.ScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template" Value="{StaticResource D2.VScrollBar}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource D2.HScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips: black box with gold rim, like an item hover -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#0A0805"/>
        <Setter Property="Foreground" Value="{StaticResource D2.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource D2.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
    </Style>

</ResourceDictionary>
